# ---- Public (safe to expose in the browser) ----
VITE_API_URL=

# ---- Server-only secrets: never prefix with VITE_ ----
# Cloudflare R2 (dynamic Our Work / Reels media + metadata)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public read URL for the bucket (custom domain or r2.dev), no trailing slash
R2_PUBLIC_BASE_URL=

# Admin panel (/admin) shared owner password
ADMIN_PASSWORD=
# Random string, 32+ characters, used to encrypt the admin session cookie
SESSION_SECRET=
